# Template for dev/.env (chmod 600 this file when real)
# NEVER commit the real dev/.env
# NOTE: FTP deployment is legacy. Current deployment is git push via SSH.

SITE_DOMAIN="relu.chat"
LOCAL_SITE_DIR="/path/to/local/clone"

FTP_HOST="your-ftp-host"
FTP_USER="your-ftp-user"
FTP_PASS="REPLACE_WITH_ROTATED_PASSWORD"
FTP_REMOTE_ROOT=""
FTP_USE_TLS="false"
FTP_PASSIVE_MODE="true"
FTP_TIMEOUT="30"

GITHUB_REPO_URL="https://github.com/yunusemrejr/relu-chat.git"
